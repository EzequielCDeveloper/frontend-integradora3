# =============================================================================
# Monorepo Root .gitignore — Solidez MX (movil-trabajador, movil-empleador, web-admin)
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo & React Native (movil-trabajador / movil-empleador)
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
**/ios/
**/android/

# Native Signing & Certificates (OWASP / Security)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.keystore

# Vite & Web Build Outputs (web-admin)
dist/
dist-ssr/
build/
out/

# Environment Variables & Secrets (NEVER commit secrets)
.env
.env.*
!.env.example
*.local

# Testing, Coverage & E2E Artifacts (Vitest, Jest, Playwright, Maestro)
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.maestro/tests/
maestro-artifacts/

# TypeScript & Bundler Caches
*.tsbuildinfo
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.turbo/

# Logs & Crash Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.orig.*

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
