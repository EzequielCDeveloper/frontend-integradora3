# URL base del backend / Edge Functions (cuando se habilite integración real)
VITE_API_BASE_URL=https://api.example.com/v1

# Usar repositorio mock centralizado en memoria (true por defecto en Fase Frontend)
VITE_USE_MOCK_API=true

